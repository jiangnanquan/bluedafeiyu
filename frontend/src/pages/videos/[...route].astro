---
import VideoArchivePage from '../../components/archive/VideoArchivePage.astro';
import {archivePages} from '../../lib/archive.mjs';

export function getStaticPaths() {
  return [...archivePages.values()].filter(page=>page.url.startsWith('/videos/'))
    .map(page=>({params:{route:page.url.slice('/videos/'.length,-'.html'.length)},props:{page}}));
}
const {page}=Astro.props;
---
<VideoArchivePage {page} />
