---
import TopicPage from "../../components/archive/TopicPage.astro";
import { archivePages } from "../../lib/archive.mjs";
export function getStaticPaths() {
 return [...archivePages].flatMap(([url,page])=>{const match=url.match(/^\/topics\/([^\/]+)\.html$/);return match?[{params:{id: match[1]},props:{page}}]:[];});
}
const {page}=Astro.props;
---
<TopicPage {page} />
