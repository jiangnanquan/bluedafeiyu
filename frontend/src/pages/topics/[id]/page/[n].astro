---
import TopicPage from "../../../../components/archive/TopicPage.astro";
import { archivePages } from "../../../../lib/archive.mjs";
export function getStaticPaths() {
 return [...archivePages].flatMap(([url,page])=>{const match=url.match(/^\/topics\/([^\/]+)\/page\/(\d+)\.html$/);return match?[{params:{id: match[1], n: match[2]},props:{page}}]:[];});
}
const {page}=Astro.props;
---
<TopicPage {page} />
