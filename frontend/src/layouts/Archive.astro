---
import V2Meta from '../components/v2/V2Meta.astro';
import PreviewDialog from '../components/archive/PreviewDialog.astro';
import ShareCardDialog from '../components/archive/ShareCardDialog.astro';
import TopicDownloadDialog from '../components/archive/TopicDownloadDialog.astro';
import { hasAiMarkdown } from '../../scripts/ai-content.mjs';
import '../components/library/styles.css';
import SiteShell from '../components/library/SiteShell.astro';
import themeScript from '../../public/theme.js?raw';
import componentRuntime from '../../public/components/runtime.js?raw';
const ASSET_VERSION = '20261117-visual-3';
const { title, desc, path = '/', active = '', bodyPage = active, og, type = 'website', shareDesc = '',
  robots = 'index,follow', canonical = '', pageStyles = [], bodyAttrs = {}, schemas = [] } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <V2Meta {title} {desc} {path} {og} {type} {shareDesc} {robots} {canonical} />
    <link rel="describedby" href="/llms.txt" type="text/plain" />
    {hasAiMarkdown(path) && <link rel="alternate" href={path + '.md'} type="text/markdown" title="简体中文 Markdown" />}
    <link rel="icon" href="/favicon.png" />
    <script is:inline set:html={themeScript}></script>
    <script is:inline set:html={componentRuntime}></script>
    {pageStyles.map(href => <link rel="stylesheet" {href} />)}
    <script is:inline src={"/archive-labels.js?v="+ASSET_VERSION} defer></script>
    <script is:inline src={"/archive-copy.js?v="+ASSET_VERSION} defer></script>
    <script is:inline src={"/lang.js?v="+ASSET_VERSION} defer></script>
    <script is:inline src="/analytics.js" defer></script>
    {schemas.map(schema => <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />)}
    <slot name="head" />
  </head>
  <body class:list={['archive', 'refined', 'unified-site']} data-design-version="20261117-unified" data-archive data-i18n-page={bodyPage} data-page={active} {...bodyAttrs}>
    <SiteShell activePage={active}><slot /></SiteShell>
    <PreviewDialog />
    <ShareCardDialog />
    <TopicDownloadDialog />
    <script is:inline src={"/work-stats.js?v="+ASSET_VERSION} defer></script>
    <script src="../scripts/archive-entry.js"></script>
    <script is:inline src={"/archive/filter-select.js?v="+ASSET_VERSION} defer></script>


    <slot name="scripts" />
    <script src="../scripts/site-interactions.js"></script>
    <script is:inline src={"/components/home-controls.js?v="+ASSET_VERSION} defer></script>
  </body>
</html>
