---
import Archive from '../../layouts/Archive.astro';
import {SITE} from '../../lib/v2.mjs';
import SubmissionForm from '../SubmissionForm.astro';
import CreatorRegistration from '../CreatorRegistration.astro';
import PageHeading from '../archive/PageHeading.astro';
import {submissionCopy} from '../submissions/submission-copy.mjs';
const {mode='image'}=Astro.props;
const path=mode==='video'?'/submit-video.html':'/submit.html';
---
<Archive title="AI娘二创投稿与视频作者登记 | 蓝色大肥鱼" desc="提交 AI 娘原图或 ZIP 图片集，或登记自己的 Bilibili 主页。图片与视频逐条审核，通过后收录到对应档案。" {path} active="submit" bodyAttrs={{'data-submission-mode':mode}} bodyPage="submit" robots="noindex,follow">
  <div class="submission-page" data-document-content>
    <div data-submission-heading data-image-title={submissionCopy.imageTitle[0]} data-image-lead={submissionCopy.imageLead[0]} data-video-title={submissionCopy.videoTitle[0]} data-video-lead={submissionCopy.videoLead[0]} data-i18n-attr="data-image-title:d.submission.imageTitle,data-image-lead:d.submission.imageLead,data-video-title:d.submission.videoTitle,data-video-lead:d.submission.videoLead"><PageHeading eyebrow={mode==='video'?'CREATOR REGISTRATION':'SUBMIT'} title={submissionCopy[mode+'Title'][0]} titleKey={'d.submission.'+mode+'Title'} description={submissionCopy[mode+'Lead'][0]} descriptionKey={'d.submission.'+mode+'Lead'} /></div>
    <nav class="submission-media-tabs section-tabs" role="tablist" aria-label="投稿方式" data-i18n-attr="aria-label:d.design.submissionMode">
      <button class="tab" type="button" role="tab" id="image-submission-tab" data-submission-mode="image" aria-controls="image-submission-panel" aria-selected={mode==='image'} data-i18n="d.design.imageSubmit">图片作品投稿</button>
      <button class="tab" type="button" role="tab" id="video-submission-tab" data-submission-mode="video" aria-controls="creator-registration" aria-selected={mode==='video'} data-i18n="d.creatorTitle">视频创作者登记</button>
    </nav>
    <section id="image-submission-panel" role="tabpanel" aria-labelledby="image-submission-tab" hidden={mode!=='image'}>
      <SubmissionForm />
      <section class="sub-guide"><h2 data-i18n="submit.guide.title">投稿指南</h2><div class="guide-grid"><div class="guide-item"><b data-i18n="d.submission.singleImage">单张图片</b><span>PNG / JPG / GIF / WebP / APNG</span><span>≤ 10 MiB</span></div><div class="guide-item"><b data-i18n="d.submission.zipSet">ZIP 图片集</b><span>≤ 32 MiB · ≤ 100</span><span data-i18n="submit.form.archiveHint">ZIP 仅可包含图片，不支持加密或嵌套压缩包。包内图片共用本次填写的信息，每张独立审核并自动去重。</span></div></div><p class="hint" data-i18n="submit.note2">投稿先进入审核队列，审核通过后批量发布。维护者会核对作品类型，并补充标签、来源和授权信息。</p><div class="sub-actions"><a class="button" href={SITE.repoContent+'/issues/new?template=sticker-submission.yml'} target="_blank" rel="noopener noreferrer" data-i18n="submit.channel.github">GitHub 投稿表单</a><a class="button" href="/about.html#license" data-i18n="work.licenseTitle">授权说明</a></div></section>
    </section>
    <CreatorRegistration hidden={mode!=='video'} />
  </div>
  <Fragment slot="scripts"><script is:inline src="/page-scripts/submit-0.js?v=20261117-visual-3" defer></script><script is:inline src="/page-scripts/creator-registration.js?v=20261117-visual-3" defer></script></Fragment>
</Archive>
