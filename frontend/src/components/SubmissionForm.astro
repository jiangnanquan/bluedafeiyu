---
import categories from '../../../data/categories.json';
import characters from '../../../data/characters.json';
const turnstileSitekey=(import.meta.env.PUBLIC_TURNSTILE_SITEKEY||'').trim();
---
<form class="sub-form" id="submission-form" novalidate data-api-endpoint="/api/v1/submissions" data-turnstile-sitekey={turnstileSitekey||undefined}>
  <div class="sub-block">
    <label class="drop" for="f-files" data-upload-drop tabindex="0"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 8 5-5 5 5M12 3v12"/></svg><b data-i18n="d.submission.dropPrompt">选择图片或 ZIP，或拖拽到这里</b><span data-i18n="submit.form.files">图片或 ZIP 压缩包</span></label>
    <input class="sr-only" type="file" id="f-files" name="image" accept="image/png,image/jpeg,image/gif,image/webp,image/apng,.zip,application/zip,application/x-zip-compressed" aria-describedby="files-hint archive-hint" required />
    <p class="hint" id="files-hint" data-i18n="submit.form.filesHint">支持 PNG / JPG / GIF / WebP / APNG 原图（单张 ≤ 10 MiB），或 ZIP 图片集（≤ 32 MiB、最多 100 张，包内单图 ≤ 16 MiB，解压总量 ≤ 64 MiB）。</p>
    <p class="hint" id="archive-hint" data-i18n="submit.form.archiveHint">ZIP 仅可包含图片，不支持加密或嵌套压缩包。包内图片共用本次填写的信息，每张独立审核并自动去重。</p>
    <p class="drop-preview" data-upload-selected role="status" hidden></p>
  </div>
  <div class="sub-block">
    <label for="f-name"><span data-i18n="submit.form.name">图片 / 图集名称</span> <span class="req-mark">*</span></label>
    <input id="f-name" name="name" type="text" autocomplete="off" maxlength="120" required />
    <label for="f-desc" data-i18n="submit.form.desc">一句话说明</label>
    <textarea id="f-desc" name="description" rows="3" maxlength="500"></textarea>
  </div>
  <fieldset class="sub-block character-field" id="f-character" aria-describedby="character-hint">
    <legend id="character-label"><span data-i18n="submit.form.character">角色</span> <span class="req-mark">*</span></legend>
    <p class="hint" id="character-hint" data-i18n="submit.form.charactersHint">可多选，请勾选图片中出现的全部角色。</p>
    <div class="character-choices chips" id="character-choices">{characters.filter(c=>c.status==='active'&&c.inSubmissionForm).map(c=><label class="chip"><input type="checkbox" name="characterIds" value={c.id} /><span data-character-name={c.id} data-character-label={c.name}>{c.name}</span></label>)}</div>
  </fieldset>
  <div class="sub-block">
    <label for="f-type"><span data-i18n="submit.form.type">作品类型</span> <span class="req-mark">*</span></label>
    <select id="f-type" name="categoryId" required aria-describedby="type-hint"><option value="" data-i18n="submit.form.selectType">请选择作品类型</option>{categories.filter(c=>c.status==='active').map(c=><option value={c.id} data-i18n={'v2.type.'+c.id} data-description={c.description} data-i18n-attr={'data-description:submit.typeDesc.'+c.id}>{c.name}</option>)}</select>
    <p class="hint" id="type-hint" aria-live="polite" data-i18n="submit.form.typeHint">每张图只能选择一个类型；不好判断时选择“其他”。</p>
    <label class="check-line"><input id="f-non-ai" name="nonAi" type="checkbox" value="true" aria-describedby="non-ai-hint" /><span data-i18n="submit.form.nonAi">非 AI 生成（可选）</span></label>
    <p class="hint" id="non-ai-hint" data-i18n="submit.form.nonAiHint">如果本次投稿的作品均通过手绘等非 AI 生成方式完成，可以勾选此项。审核收录后，将归入“非 AI 创作”分类。</p>
  </div>
  <div class="sub-block">
    <label for="f-credit"><span data-i18n="submit.form.credit">是否署名</span> <span class="req-mark">*</span></label>
    <select id="f-credit" name="credit" required><option value="anonymous" data-i18n="submit.form.anonymous">不署名</option><option value="named" data-i18n="submit.form.named">署名</option></select>
    <div id="credit-fields" hidden>
      <div class="form-row"><label for="f-credit-name"><span data-i18n="submit.form.creditName">署名名字</span> <span class="req-mark">*</span></label><input id="f-credit-name" name="creditName" type="text" autocomplete="nickname" maxlength="120" /></div>
      <div class="form-row"><label for="f-credit-url" data-i18n="submit.form.creditUrl">个人主页链接（可选）</label><input id="f-credit-url" name="creditUrl" type="url" autocomplete="url" maxlength="2048" placeholder="https://" /></div>
      <p class="hint" data-i18n="submit.form.creditHint">填写链接后，点击署名名字即可打开个人主页。这里是投稿者署名，作品来源和原作者信息请写在说明里。</p>
    </div>
    <p class="hint" data-i18n="submit.form.metaHint">作品类型由你选择，审核时会核对；Tag、来源和授权由维护者补充。知道来源或授权时可写在说明里。</p>
  </div>
  <input id="f-turnstile-token" name="turnstileToken" type="hidden" value="" />
  <div class="sub-block" id="turnstile-row" hidden><span class="hint" data-i18n="submit.form.turnstileHint">请先完成人机验证，再提交。</span><div class="turnstile-slot" id="turnstile-slot"></div><p class="form-status is-error" data-turnstile-status role="status" hidden></p></div>
  <div class="sub-block">
    <b class="sub-label"><span data-i18n="submit.form.confirmLabel">提交前确认</span> <span class="req-mark">*</span></b><p class="hint" data-i18n="submit.form.confirmHint">三条全部勾选后才能提交。</p>
    <label class="check-line"><input id="f-confirm-1" name="confirmRights" type="checkbox" required /><span data-i18n="submit.confirm1">我确认自己有权提交本次全部图片，或已获原作者允许。</span></label>
    <label class="check-line"><input id="f-confirm-2" name="confirmReview" type="checkbox" required /><span data-i18n="submit.confirm2">同意维护者核实后收录，并在收到版权要求时修改信息或删除。</span></label>
    <label class="check-line"><input id="f-confirm-3" name="confirmFanProject" type="checkbox" required /><span data-i18n="submit.confirm3">知道本站是非官方同人整理项目，图片著作权始终归原作者。</span></label>
  </div>
  <div class="sub-actions form-actions"><button class="button primary" id="btn-generate" type="submit"><span id="btn-generate-text" data-i18n="submit.form.submit">站内提交</span></button><a class="button" href="/browse.html" data-i18n="d.submission.browseFirst">先去逛逛</a><p class="form-status" id="form-status" role="status" aria-live="polite" hidden></p></div>
</form>
