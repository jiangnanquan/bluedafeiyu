---
import Archive from '../../layouts/Archive.astro';
import '../library/Collections.css';
import '../archive/ComicSeries.css';
import '../library/Guides.css';
import CollectionIndexBody from './CollectionIndexBody.astro';
import {archivePages} from '../../lib/archive.mjs';
const {kind}=Astro.props;
const path=`/${kind}.html`;
const {meta}=archivePages.get(path);
---
<Archive title={meta.title} desc={meta.description} {path} active={kind} schemas={meta.schemas}><CollectionIndexBody {kind} /></Archive>
