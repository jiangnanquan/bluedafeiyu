---
import Archive from '../../layouts/Archive.astro';
import '../library/Collections.css';
import {archiveContext} from '../../lib/archive.mjs';
import PageHeading from '../archive/PageHeading.astro';
const {works,chars,topics,button,grid,sectionHead,roleCard,collectionCard}=archiveContext;
---
<Archive title="站内组件预览" desc="开发环境中的组件与状态示例。" path="/dev/components" active="" robots="noindex,nofollow">
  <PageHeading eyebrow="COMPONENT LIBRARY" title="站内组件预览" description="检查桌面、手机和深色模式。页面通过组件参数选择样式。" />
  <section class="section"><Fragment set:html={sectionHead('按钮与链接')} /><div class="detail-actions"><Fragment set:html={button('#cards','主要操作','primary')+button('#cards','普通操作')+button('#cards','小号操作','small')} /></div></section>
  <section class="section" id="cards"><Fragment set:html={sectionHead('作品卡片与网格')+grid(works.slice(0,8),'',true)} /></section>
  <section class="section"><Fragment set:html={sectionHead('角色卡片')} /><div class="role-grid"><Fragment set:html={chars.slice(0,5).map(roleCard).join('')} /></div></section>
  <section class="section"><Fragment set:html={sectionHead('合集与下载')} /><div class="collection-grid"><Fragment set:html={topics.filter(topic=>!topic.reader).slice(0,2).map(topic=>collectionCard(topic)).join('')} /></div></section>
  <section class="section"><Fragment set:html={sectionHead('表单与状态')} /><div class="detail-actions"><label class="field">搜索<input type="search" placeholder="输入关键词" /></label><label class="field">类型<select><option>全部类型</option><option>插画</option></select></label><button class="button" disabled>不可用操作</button><button class="button" aria-busy="true" disabled>处理中</button></div><div class="empty-state"><h3>暂无内容</h3><p>更换条件后继续浏览。</p></div></section>
</Archive>
