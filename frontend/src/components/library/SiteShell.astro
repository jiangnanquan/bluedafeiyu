---
import Footer from '../archive/Footer.astro';
const {activePage=''}=Astro.props;
---
<a class="skip-link" href="#main" data-i18n="v2.skip">跳到正文</a>
<div class="app" id="app">
  <button class="drawer-backdrop" type="button" data-drawer-close tabindex="-1" aria-label="关闭导航" data-i18n-attr="aria-label:d.closeNavigation"></button>
  <aside class="sidebar" id="site-sidebar" aria-label="站点导航" data-i18n-attr="aria-label:d.home.nav">
    <div class="brand">
      <a class="brand-mark" href="/" aria-label="蓝色大肥鱼首页" data-i18n-attr="aria-label:d.home.homeLabel"><img src="/avatar.png" width="36" height="36" alt=""></a>
      <a class="brand-text" href="/">
        <div class="brand-name" data-i18n="d.home.brand">蓝色大肥鱼</div>
        <div class="brand-sub" data-i18n="d.home.brandSub">AI 娘同人档案</div>
      </a>
      <button class="collapse" id="collapse" type="button" aria-label="收起侧栏" data-i18n-attr="aria-label:d.home.collapse" aria-controls="site-sidebar" aria-expanded="true"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/><path d="m16 15-3-3 3-3"/></svg></button>
    </div>
    <nav class="nav-section" aria-label="图片与角色" data-i18n-attr="aria-label:d.home.imagesRoles">
      <div class="nav-label" data-i18n="d.home.imagesRoles">图片与角色</div>
      <a aria-label="全部图片" data-i18n-attr="aria-label:d.home.allImages" aria-current={['home','browse'].includes(activePage)?'page':undefined} class:list={['nav-item',{'is-active':['home','browse'].includes(activePage)}]} href="/"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="M18 22H4a2 2 0 0 1-2-2V6"/><path d="m22 13-1.296-1.296a2.41 2.41 0 0 0-3.408 0L11 18"/><circle cx="12" cy="8" r="2"/><rect width="16" height="16" x="6" y="2" rx="2"/></svg><span data-i18n="d.home.allImages">全部图片</span></a>
<a aria-label="角色百科" data-i18n-attr="aria-label:d.home.characters" aria-current={activePage==='characters'?'page':undefined} class:list={['nav-item',{'is-active':activePage==='characters'}]} href="/characters.html"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><line x1="21" x2="14" y1="4" y2="4"/><line x1="10" x2="3" y1="4" y2="4"/><line x1="21" x2="12" y1="12" y2="12"/><line x1="8" x2="3" y1="12" y2="12"/><line x1="21" x2="16" y1="20" y2="20"/><line x1="12" x2="3" y1="20" y2="20"/><line x1="14" x2="14" y1="2" y2="6"/><line x1="8" x2="8" y1="10" y2="14"/><line x1="16" x2="16" y1="18" y2="22"/></svg><span data-i18n="d.home.characters">角色百科</span></a>
<a aria-label="主题合集" data-i18n-attr="aria-label:d.home.topics" aria-current={activePage==='topics'?'page':undefined} class:list={['nav-item',{'is-active':activePage==='topics'}]} href="/topics.html"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg><span data-i18n="d.home.topics">主题合集</span></a>
<a aria-label="连载漫画" data-i18n-attr="aria-label:d.home.serials" aria-current={activePage==='serials'?'page':undefined} class:list={['nav-item',{'is-active':activePage==='serials'}]} href="/serials.html"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg><span data-i18n="d.home.serials">连载漫画</span></a>
<a aria-label="视频" data-i18n-attr="aria-label:d.home.videos" aria-current={activePage==='videos'?'page':undefined} class:list={['nav-item',{'is-active':activePage==='videos'}]} href="/videos.html"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><polygon points="6 3 20 12 6 21 6 3"/></svg><span data-i18n="d.home.videos">视频</span></a>
<a aria-label="创作者" data-i18n-attr="aria-label:d.home.creators" aria-current={activePage==='creators'?'page':undefined} class:list={['nav-item',{'is-active':activePage==='creators'}]} href="/creators.html"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/></svg><span data-i18n="d.home.creators">创作者</span></a>
    </nav>
    <nav class="nav-section" aria-label="我的与社区" data-i18n-attr="aria-label:d.home.communityLabel">
      <div class="nav-label" data-i18n="d.home.communityLabel">我的与社区</div>
      <a aria-label="社区项目" data-i18n-attr="aria-label:d.home.projects" aria-current={activePage==='communityProjects'?'page':undefined} class:list={['nav-item',{'is-active':activePage==='communityProjects'}]} href="/community-projects.html"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><rect width="7" height="7" x="14" y="3" rx="1"/><path d="M10 21V8a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-5a1 1 0 0 0-1-1H3"/></svg><span data-i18n="d.home.projects">社区项目</span></a>
<a aria-label="站点活动" data-i18n-attr="aria-label:d.home.events" aria-current={activePage==='event'?'page':undefined} class:list={['nav-item',{'is-active':activePage==='event'}]} href="/events.html"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/></svg><span data-i18n="d.home.events">站点活动</span></a>
<a aria-label="加入社群" data-i18n-attr="aria-label:d.home.join" aria-current={activePage==='community'?'page':undefined} class:list={['nav-item',{'is-active':activePage==='community'}]} href="/community.html"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="M14 9a2 2 0 0 1-2 2H6l-4 4V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2z"/><path d="M18 9h2a2 2 0 0 1 2 2v11l-4-4h-6a2 2 0 0 1-2-2v-1"/></svg><span data-i18n="d.home.join">加入社群</span></a>
<a aria-label="友情链接" data-i18n-attr="aria-label:d.home.friends" aria-current={activePage==='friendWall'?'page':undefined} class:list={['nav-item',{'is-active':activePage==='friendWall'}]} href="/friend-links.html"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg><span data-i18n="d.home.friends">友情链接</span></a>
    </nav>
    <hr>
    <div class="sidebar-links"><a href="/about.html" data-i18n="d.home.about">关于</a><a href="/about.html#open-data-api" data-i18n="d.openApi">开放接口</a><a href="/changelog.html" data-i18n="d.home.log">日志</a></div>
    <a aria-label="投稿" data-i18n-attr="aria-label:d.home.submit" class="cta" href="/submit.html"><span data-i18n="d.home.submit">投稿</span><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/></svg></a>
  </aside>

  <div class="main">
    <header class="topbar">
      <button class="mobile-menu" id="menu" type="button" aria-label="打开导航" data-i18n-attr="aria-label:d.home.openNav" aria-controls="site-sidebar" aria-expanded="false"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/><path d="m16 15-3-3 3-3"/></svg></button>
      <form class="search" action="/search.html" method="get" role="search">
        <svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="search" name="q" placeholder="搜索图片、角色或创作者" aria-label="搜索图片、角色或创作者" data-i18n-attr="placeholder:d.home.search,aria-label:d.home.search">
        <kbd class="kbd" aria-hidden="true">Ctrl K</kbd>
      </form>
      <div class="actions">
        <a class="button topbar-community" href="/community.html" aria-label="加入社群" data-i18n-attr="aria-label:d.home.join"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="M14 9a2 2 0 0 1-2 2H6l-4 4V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2z"/><path d="M18 9h2a2 2 0 0 1 2 2v11l-4-4h-6a2 2 0 0 1-2-2v-1"/></svg><span class="button-label" data-i18n="d.home.join">加入社群</span></a>
        <a class="button primary" href="/submit.html" aria-label="投稿" data-i18n-attr="aria-label:d.home.submit"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/></svg><span class="button-label" data-i18n="d.home.submit">投稿</span></a>
        <button class="button icon-btn" id="theme" data-theme-toggle type="button" aria-label="切换深色模式" data-i18n-attr="aria-label:d.home.themeLabel"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8a2.83 2.83 0 0 0 4 4 4 4 0 1 1-4-4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.9 4.9 1.4 1.4"/><path d="m17.7 17.7 1.4 1.4"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.3 17.7-1.4 1.4"/><path d="m19.1 4.9-1.4 1.4"/></svg></button>
        <div class="lang-picker" id="language-picker">
<button class="lang lang-trigger" id="lang" type="button" aria-label="切换语言，当前简体中文" aria-haspopup="listbox" aria-expanded="false" aria-controls="language-options"><span>简中</span><svg class="icon lang-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
<ul class="lang-panel lang-menu" id="language-options" role="listbox" aria-label="页面语言" hidden>
<li class="lang-option" role="option" aria-selected="true" data-value="zh-CN" tabindex="-1"><span>简体中文</span><svg class="icon lang-check" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></li>
<li class="lang-option" role="option" aria-selected="false" data-value="zh-TW" tabindex="-1"><span>繁體中文</span><svg class="icon lang-check" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></li>
<li class="lang-option" role="option" aria-selected="false" data-value="en" tabindex="-1"><span>English</span><svg class="icon lang-check" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></li>
<li class="lang-option" role="option" aria-selected="false" data-value="ja" tabindex="-1"><span>日本語</span><svg class="icon lang-check" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></li>
</ul><span class="sr-only" role="status" id="language-status"></span><span data-language-fallback></span>
</div>
      </div>
    </header>

    <main class="content" id="main"><slot /></main><Footer /></div></div>
